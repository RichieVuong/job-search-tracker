GOOGLE_CLIENT_ID=put-your-google-client-id-here
GOOGLE_CLIENT_SECRET=put-your-google-client-secret-here
SESSION_SECRET=replace-with-a-long-random-string
# Reference only: the app does not automatically load .env files.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8035/auth/callback
APP_ENV=development
